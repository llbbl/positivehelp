TURSO_DATABASE_URL=libsql://your-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional canonical origin; defaults to the deployment URL on Vercel, localhost
# outside production, and https://positive.help otherwise. When set, it must be
# available at build time, because it is inlined into the client bundle.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Number of trusted reverse proxies in front of the app (default 1, 0 = none).
# The count must hold for every route to the app: if clients can bypass an outer
# proxy, any extra hop lets them forge x-forwarded-for and bypass rate limits.
TRUSTED_PROXY_HOPS=1
