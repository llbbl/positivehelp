TURSO_DATABASE_URL=libsql://your-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional explicit canonical origin. Defaults to localhost outside production
# and https://positive.help in production; Coolify (COOLIFY_URL/COOLIFY_FQDN)
# and Vercel URLs are detected automatically.
#
# On Coolify this must be set as a BUILD variable, not just a runtime one:
# next.config.ts resolves it at build time and inlines it into the client
# bundle, so a runtime-only value never reaches the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Rate limiter: how many rightmost x-forwarded-for hops to trust for client IP.
# Coolify's Traefik alone → 1 (the code default, kept here as the safe template
# value). Direct-to-origin with no proxy → 0.
#
# Production (Cloudflare → Coolify) uses 2, set on the Coolify application
# rather than copied from this file. Setting this HIGHER than the real number of
# trusted hops is a rate-limit bypass: the extra hop makes the limiter read an
# attacker-controlled x-forwarded-for entry. Only raise it once the origin is
# firewalled to Cloudflare's IP ranges — see the README.
TRUSTED_PROXY_HOPS=1
