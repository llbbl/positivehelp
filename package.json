{
	"name": "positivehelp",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"vercel-build": "pnpm db:migrate && next build",
		"start": "pnpm db:migrate && next start",
		"lint": "pnpm exec biome lint .",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"db:reset": "drizzle-kit reset --config drizzle.config.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"knip": "knip --no-progress",
		"check-file": "node scripts/check-file.js",
		"bun-tsc": "bun scripts/check-file.js",
		"node-tsc": "node scripts/check-file.js",
		"delete-message": "tsx scripts/delete-message.ts"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.9.9",
		"@libsql/client": "^0.18.0",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toast": "^1.2.23",
		"@tanstack/react-table": "^9.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.3",
		"lucide-react": "^1.49.0",
		"next": "16.3.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"winston": "^3.19.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@jest/globals": "^30.5.2",
		"@next/env": "^16.3.8",
		"@swc/core": "^1.16.13",
		"@swc/jest": "^0.2.39",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.11",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"knip": "6.39.0",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"modulePathIgnorePatterns": [
			"<rootDir>/.next/"
		],
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/$1"
		},
		"transformIgnorePatterns": [
			"<rootDir>/node_modules/.pnpm/(?!(?:@tanstack\\+(?:react-table|table-core))@)"
		],
		"transform": {
			"^.+\\.js$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "ecmascript",
							"jsx": true
						},
						"target": "es2017"
					}
				}
			],
			"^.+\\.tsx$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "typescript",
							"tsx": true
						},
						"transform": {
							"react": {
								"runtime": "automatic"
							}
						},
						"target": "es2017"
					}
				}
			],
			"^.+\\.ts$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "typescript",
							"tsx": false
						},
						"target": "es2017"
					}
				}
			]
		}
	}
}
