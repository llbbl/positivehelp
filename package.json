{
	"name": "positivehelp",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"vercel-build": "pnpm db:migrate && next build",
		"start": "pnpm db:migrate && next start",
		"lint": "pnpm exec biome lint .",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"knip": "knip --no-progress",
		"check-file": "node scripts/check-file.js",
		"bun-tsc": "bun scripts/check-file.js",
		"node-tsc": "node scripts/check-file.js",
		"delete-message": "tsx scripts/delete-message.ts",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.9.15",
		"@libsql/client": "^0.18.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-toast": "^1.3.1",
		"@tanstack/react-table": "^9.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.61.0",
		"next": "16.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"winston": "^3.19.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@next/env": "^16.4.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.11",
		"knip": "6.41.0",
		"postcss": "^8.5.30",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"vite": "^8.3.4",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^27.4.0",
		"@testing-library/dom": "^10.4.1"
	}
}
