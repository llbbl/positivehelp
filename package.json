{
	"name": "positivehelp",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"vercel-build": "pnpm db:migrate && next build",
		"start": "pnpm db:migrate && next start",
		"lint": "pnpm exec biome lint .",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"db:reset": "drizzle-kit reset --config drizzle.config.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"knip": "knip --no-progress --no-exit-code",
		"check-file": "node scripts/check-file.js",
		"bun-tsc": "bun scripts/check-file.js",
		"node-tsc": "node scripts/check-file.js",
		"delete-message": "tsx scripts/delete-message.ts"
	},
	"dependencies": {
		"@babel/helpers": "^8.0.0",
		"@clerk/nextjs": "^7.7.1",
		"@libsql/client": "^0.17.4",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toast": "^1.2.23",
		"@tanstack/react-table": "^8.21.3",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.33.0",
		"next": "16.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@jest/globals": "^30.4.1",
		"@next/env": "^16.3.0",
		"@swc/core": "^1.15.47",
		"@swc/jest": "^0.2.39",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "^0.31.10",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "30.4.1",
		"knip": "6.32.1",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/$1"
		},
		"transform": {
			"^.+\\.tsx$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "typescript",
							"tsx": true
						},
						"transform": {
							"react": {
								"runtime": "automatic"
							}
						},
						"target": "es2017"
					}
				}
			],
			"^.+\\.ts$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "typescript",
							"tsx": false
						},
						"target": "es2017"
					}
				}
			]
		}
	}
}
